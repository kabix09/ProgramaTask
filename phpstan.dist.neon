includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - tests/bootstrap.php

    ignoreErrors:
        - '#Method .*::.*has parameter .* with no value type specified in iterable type array#'

    treatPhpDocTypesAsCertain: false
