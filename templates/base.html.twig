<!DOCTYPE html>
<html lang="pl">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Programa Task Solution{% endblock %}</title>
        <link rel="icon" href="https://programa.pl/favicon.ico">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
            <style>
                :root {
                    --programa-red: #e30613;
                    --programa-dark: #212529;
                }
                body, html {
                    height: 100%;
                    margin: 0;
                }
                body {
                    background: radial-gradient(circle, #ffffff 0%, #e9ecef 100%);
                    display: flex;
                    flex-direction: column;
                }
                .navbar-brand img {
                    height: 30px;
                }
                .main-container {
                    flex: 1;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }
                .btn-programa {
                    background-color: var(--programa-red);
                    border-color: var(--programa-red);
                    color: white;
                    padding: 12px 30px;
                    font-weight: bold;
                    transition: all 0.3s ease;
                }
                .btn-programa:hover {
                    background-color: var(--programa-dark);
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                }
                footer {
                    background: rgba(255,255,255,0.8);
                }
            </style>
        {% endblock %}
    </head>

    <body>
    <nav class="navbar navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="https://programa.pl/file/images/logo_color.svg" alt="Programa Logo" class="me-2">
                <span class="fw-bold text-dark">Task Solution</span>
            </a>
            <div class="d-flex">
                <a href="{{ github_url }}" target="_blank" class="btn btn-outline-secondary btn-sm">GitHub Repo</a>
            </div>
        </div>
    </nav>

    <main class="main-container">
        {% block container %}{% endblock %}
    </main>

    <footer class="py-3 border-top">
        <div class="container d-flex justify-content-between align-items-center text-muted small">
            <span>&copy; {{ "now"|date("Y") }} zadanie rekrutacyjne by kabix09</span>
            <span>Zrealizowano dla <strong>Programa.pl</strong></span>
        </div>
    </footer>

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.min.js"></script>
    {% endblock %}
    </body>
</html>
